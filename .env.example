# SentinelML local configuration. Copy to .env — never commit .env.
SENTINELML_ENV=local
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8102
MODEL_DIR=artifacts

# Streaming. Kafka broker is optional; default in-process queue for smoke.
STREAM_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_ENRICHED=transactions.enriched
KAFKA_TOPIC_PREDICTIONS=fraud.predictions
KAFKA_TOPIC_ALERTS=fraud.alerts
KAFKA_TOPIC_FEEDBACK=model.feedback

# Feature store. Redis optional; in-memory used when Redis is down.
ONLINE_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/2
FEATURE_LABEL_DELAY_DAYS=7

# Audit DB. Local SQLite. Do not point at the user's existing Postgres by default.
AUDIT_DATABASE_URL=sqlite:///artifacts/audit.db
# Production compose example (unused locally):
# AUDIT_DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinelml

# MLflow local file store (not a cloud tracking server).
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=sentinelml

# Decision engine (fractions of probability). Default REVIEW when ambiguous.
DECISION_ALLOW_MAX=0.20
DECISION_REVIEW_MAX=0.70
# Real blocking needs legal/business validation. See docs/architecture/decision_engine.md

# Business cost ASSUMPTIONS (not bank costs). FP=1, FN=25.
COST_FALSE_POSITIVE=1.0
COST_FALSE_NEGATIVE=25.0
